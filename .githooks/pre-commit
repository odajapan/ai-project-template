#!/usr/bin/env bash
# Template-provided guard hook: refuse direct commits to main/master.
#
# This directory owns commit-time hooks (core.hooksPath, set by `make hooks`),
# so the pre-commit framework's hooks in .pre-commit-config.yaml do NOT run on
# `git commit` here; `make precommit` runs them on demand over the whole tree,
# and `make check` is the gate before every commit. This hook stays focused on
# branch protection so a commit is never slowed by mypy.

set -euo pipefail

current_ref=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

case "$current_ref" in
  main|master)
    echo "✖ Direct commits to '${current_ref}' are not allowed." >&2
    echo "  Create a feature branch instead, e.g.:" >&2
    echo "    git switch -c claude/<task-name>" >&2
    exit 1
    ;;
esac

exit 0
