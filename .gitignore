# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# DotEnv configuration (env.example is the committed template)
.env
.env.*
.envrc

# Database
*.db
*.rdb

# Pycharm
.idea

# VS Code
# (We do commit .vscode/settings.json so the project's env-manager defaults
# are shared. Personal overrides should go to .vscode/settings.local.json.)
.vscode/*
!.vscode/settings.json
.vscode/settings.local.json

# Spyder
.spyproject/

# Jupyter NB Checkpoints
.ipynb_checkpoints/

# Exclude data from source control by default, but keep the directory
# skeleton so `make data` works from a clean clone. These 4 lines interact —
# do not reorder them, or datasets will start getting committed.
/data/*
!/data/raw/
!/data/interim/
!/data/processed/
!/data/external/
/data/*/*
!/data/*/.gitkeep

# Mac OS-specific storage files
.DS_Store

# vim
*.swp
*.swo

# Mypy cache
.mypy_cache/

# Claude Code: ignore personal overrides and auto-generated state
.claude/settings.local.json
.claude/worktrees/

# MCP server config (may contain credentials)
.mcp.json

# Node / web workspace
node_modules/
web/dist/
web/build/
web/.next/
web/coverage/
*.tsbuildinfo
