{
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make precommit)",
      "Bash(make requirements)",
      "Bash(make hooks)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pre-commit run:*)",
      "Bash(uv pip install:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b claude/*)",
      "Bash(git switch:*)",
      "Bash(git push origin claude/*)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(pnpm:*)",
      "Bash(find:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(cat .env)",
      "Bash(cat *.env)",
      "Bash(rm -rf *)",
      "Bash(rm -rf data/raw:*)",
      "Bash(rm -rf models:*)",
      "Bash(rm -rf .git:*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase -i:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "make format 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
